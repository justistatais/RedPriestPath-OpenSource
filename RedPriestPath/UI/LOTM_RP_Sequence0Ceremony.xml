<?xml version="1.0" encoding="utf-8"?>
<Context ColorSet="BodyTextCool" FontStyle="Shadow">
	<AlphaAnim
		ID="CeremonyAnimation"
		AlphaBegin="0"
		AlphaEnd="1"
		Speed="0.5"
		Function="Root"
		Size="parent,parent"
		Cycle="Once"
		Stopped="1">
		<Grid
			ID="CeremonyBackdrop"
			Style="Divider6Grid"
			ConsumeMouse="1"
			Size="960,700"
			Color="0,0,0,220"
			Anchor="C,C">
			<Image
				ID="GradientT"
				Anchor="L,T"
				AnchorSide="I,O"
				Texture="Controls_Gradient_HalfRadial"
				Size="parent,180"
				Color="0,0,0,255"/>
