					ID="ContinueButton"
					Size="220,41"
					Anchor="C,C"
					Offset="0,324"
					String="LOC_CONTINUE"
					Style="MainButton"
					FontStyle="Shadow"/>
			</SlideAnim>
		</AlphaAnim>
	</AlphaAnim>
</Context>
