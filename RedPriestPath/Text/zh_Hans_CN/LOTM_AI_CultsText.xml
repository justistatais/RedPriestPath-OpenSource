 <Row Tag="LOC_LOTM_CULT_HANGED_MAN_T2_NAME" Language="zh_Hans_CN"><Text>血肉</Text></Row>
 <Row Tag="LOC_LOTM_CULT_HANGED_MAN_T3_NAME" Language="zh_Hans_CN"><Text>堕落</Text></Row>
