<?xml version="1.0" encoding="utf-8"?>
<Mod id="7E4D8D9C-0C96-4B9C-A3D4-6A1E6B19D970" version="393">
	<Properties>
		<Name>诡秘之主单位与玩法</Name>
		<Teaser>Choose a Pathway and advance from Sequence 9 to 0 | 选择途径，从序列9晋升至序列0</Teaser>
		<Description>Paragon, Red Priest and Black Emperor Pathways with potion digestion, Rampager Workshops, 21 unique Sealed Artifacts and a built-in manual. Supports 简体中文 and English.</Description>
		<Authors>LOTM Red Priest Path Team</Authors>
		<CompatibleVersions>2.0</CompatibleVersions>
		<SupportsMultiplayer>1</SupportsMultiplayer>
	</Properties>
	<Dependencies>
		<Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="LOC_EXPANSION2_MOD_TITLE"/>
	</Dependencies>
	<References>
		<Mod id="5aceed03-8639-4a81-8cbf-03f54d543502" title="Quick Deals"/>
	</References>
	<ActionCriteria>
		<Criteria id="LOTM_RP_EXPANSION_2">
			<RuleSetInUse>RULESET_EXPANSION_2</RuleSetInUse>
		</Criteria>
		<Criteria id="LOTM_RP_RESCUE_MODE">
			<RuleSetInUse>RULESET_EXPANSION_2</RuleSetInUse>
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>GAMEMODE_LOTM_RESCUE</ConfigurationId>
				<Value>1</Value>
			</ConfigurationValueMatches>
		</Criteria>
		<Criteria id="LOTM_RP_NORMAL_MODE">
			<RuleSetInUse>RULESET_EXPANSION_2</RuleSetInUse>
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>GAMEMODE_LOTM_RESCUE</ConfigurationId>
				<Value>0</Value>
			</ConfigurationValueMatches>
		</Criteria>
		<Criteria id="LOTM_RP_RESCUE_CLANS_MODE">
			<RuleSetInUse>RULESET_EXPANSION_2</RuleSetInUse>
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>GAMEMODE_LOTM_RESCUE</ConfigurationId>
				<Value>1</Value>
			</ConfigurationValueMatches>
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>GAMEMODE_BARBARIAN_CLANS</ConfigurationId>
				<Value>1</Value>
			</ConfigurationValueMatches>
		</Criteria>
		<Criteria id="LOTM_RP_LANGUAGE_ZH">
			<RuleSetInUse>RULESET_EXPANSION_2</RuleSetInUse>
		</Criteria>
		<Criteria id="LOTM_RP_LANGUAGE_EN">
			<RuleSetInUse>RULESET_EXPANSION_2</RuleSetInUse>
