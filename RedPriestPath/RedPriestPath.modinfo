				<Group>Game</Group>
				<ConfigurationId>LOTM_RP_TEXT_LANGUAGE</ConfigurationId>
				<Value>en_US</Value>
			</ConfigurationValueMatches>
		</Criteria>
		<Criteria id="LOTM_RP_EXPANSION_2_QUICK_DEALS">
			<RuleSetInUse>RULESET_EXPANSION_2</RuleSetInUse>
			<ModInUse>5aceed03-8639-4a81-8cbf-03f54d543502</ModInUse>
		</Criteria>
